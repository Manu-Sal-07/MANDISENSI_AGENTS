# ==============================================================================
# MandiSense AI — Root Backend Environment Variables Contract
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED VARIABLES (Production & Local)
# ------------------------------------------------------------------------------

# PostgreSQL connection string
# Production: Render Database connection string
# Local: postgresql://user:pass@localhost:5432/mandisense
DATABASE_URL=postgresql://user:pass@localhost:5432/mandisense

# Redis connection string
# Production: Render Cache connection string
# Local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# BBC News API Key (Access credentials for News API v2)
# Required to fetch news articles for external factor predictions.
NEWS_API_KEY=your_news_api_key_here

# ------------------------------------------------------------------------------
# 2. OPTIONAL VARIABLES / PRODUCTION SETTINGS
# ------------------------------------------------------------------------------

# Application Environment (e.g., development, production, test)
# Set to 'production' on Render
APP__ENVIRONMENT=production

# Server listening port (Render sets this dynamically)
PORT=8000

# Rate limiting for API requests (requests per second per client IP)
RATE_LIMIT_PER_SECOND=60

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT / DEBUG SETTINGS
# ------------------------------------------------------------------------------

# Enable debug mode and interactive API documentation (e.g., swagger)
# Set to 'false' in production.
APP__DEBUG=false

# Logger verbosity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOGGING__LEVEL=INFO

# Permit all cross-origin requests (CORS).
# Set to 'false' in production if web access should be restricted to trusted domains.
CORS_ALLOW_ALL_ORIGINS=true

# ------------------------------------------------------------------------------
# 4. DATA.GOV.IN DAILY PRICE FEED (optional)
# ------------------------------------------------------------------------------

# Free API key for data.gov.in's daily mandi price feed, used by the nightly job's
# ingestion stage (scripts/run_nightly_job.py). The charts read the Agmarknet market
# panel built by scripts/build_farmer_world.py; the old POST /v1/market-data/sync
# append is disabled. Get your own free key at https://data.gov.in (My Account -> API Keys).
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# ------------------------------------------------------------------------------
# 5. CEDA (ASHOKA UNIVERSITY) AGMARKNET API — ARRIVAL VOLUMES
# ------------------------------------------------------------------------------

# Bearer token for CEDA's Agmarknet API (api.ceda.ashoka.edu.in). Unlike
# data.gov.in, this feed carries arrival *quantities* as their own endpoint,
# separate from price — a dimension the free data.gov.in feed has never
# published at all. Wired into the nightly ingestion
# (forecasting/pipeline.py: _backfill_arrivals_from_ceda) purely as an
# arrivals top-up: it never overrides a price data.gov.in already supplied,
# and it is a complete no-op with this unset -- ingestion behaves exactly as
# it does today. Request access by emailing ceda@ashoka.edu.in (no
# self-serve signup exists as of this writing). Once set, arrival-dependent
# features unlock automatically on the next nightly run with no other
# change required: farmer/supply_signal.py's "based on the last available
# print" caveat, and the trader arrival_surge / arrival_drought scenarios
# in trader/scenarios.py.
CEDA_API_KEY=your_ceda_bearer_token_here

# ------------------------------------------------------------------------------
# CHATBOTS (farmer and trader assistants) -- all optional
# ------------------------------------------------------------------------------
# With none of these set the chatbots still work: they route each question to the
# real tools and write the answer in the chosen language (English, Kannada or
# Hindi), searching the live web for anything the mandi records do not cover.
# Setting ONE key upgrades the language and reasoning by using a hosted model
# with tool calling. First key found wins, in this order:
#   ANTHROPIC_API_KEY (Claude)  ->  GROQ_API_KEY  ->  OPENAI_API_KEY
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Force a provider (anthropic | groq | openai | none) and/or a model name.
CHAT_PROVIDER=auto
CHAT_MODEL=
# Optional: any OpenAI-compatible endpoint for OPENAI_API_KEY.
OPENAI_BASE_URL=
# Optional: your email raises MyMemory's free translation quota (web snippets
# are translated into Kannada/Hindi when no hosted model is configured).
MYMEMORY_EMAIL=

# ------------------------------------------------------------------------------
# LANGUAGE-MODEL LAYER (explanations, AI Brief) -- optional
# ------------------------------------------------------------------------------
# Without a key every explanation is written by rules from the same facts, so the product is complete either way.
#   auto -> Anthropic if ANTHROPIC_API_KEY is set, else Groq if GROQ_API_KEY is set, else rules
MANDISENSE_LLM_PROVIDER=auto
# Model that paraphrases the code-written sentences (Groq model ids).
MANDISENSE_GROQ_MODEL=openai/gpt-oss-120b
# A DIFFERENT model family that judges whether each paraphrase still means the same thing.
MANDISENSE_JUDGE_MODEL=qwen/qwen3.8-27b
# Groq's free tier allows ~8,000 tokens per minute; calls wait out a 429 (up to 45 s) and otherwise fall back to rules.
# Never commit a real key: .env is git-ignored.
